# SAP ADT CLI - SAP Connection Credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required
SAP_URL=https://your-sap-system.example.com:8000
SAP_USERNAME=YOUR_USERNAME
SAP_PASSWORD=YOUR_PASSWORD
SAP_CLIENT=100

# Optional
SAP_LANGUAGE=EN
SAP_VERIFY_SSL=0
SAP_ALLOW_WRITE=0
SAP_ALLOW_TRANSPORT=0

# Per-profile password for the 'env' keystore backend (profile 'dev').
# SAP_ADT_DEV_PASSWORD=YOUR_PASSWORD
# Master passphrase for the 'file' keystore backend in non-interactive runs.
# SAP_ADT_MASTER_PASSPHRASE=YOUR_MASTER_PASSPHRASE
