{
  "name": "sap-watt-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "dev": "npm run prepare:docs && astro dev --host 127.0.0.1",
    "build": "npm run prepare:docs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/docs.test.mjs",
    "check:links": "python3 scripts/check_site.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/starlight": "^0.43.2",
    "astro": "^7.4.13",
    "sharp": "^0.35.5"
  }
}
